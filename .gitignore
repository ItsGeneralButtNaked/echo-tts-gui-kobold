# Ignore everything in characters
characters/*

# But allow the default folder
!characters/Default/
!characters/Default/**

# Ignore everything in ASCII art
ascii_art/*

# But allow the default folder
!ascii_art/default/
!ascii_art/default/**

# But allow the Ecko folder
!ascii_art/ecko/
!ascii_art/ecko/**

# But allow the CivChan folder
!ascii_art/civchan/
!ascii_art/civchan/**

# Ignore everything in images
images/*

# But allow the default folder
!images/default/
!images/default/**

# But allow the ECKO folder
!images/ECKO/
!images/ECKO/**

# But allow the CivChan folder
!images/CivChan/
!images/CivChan/**

# Ignore everything in videos
videos/*

# But allow the default folder
!videos/default/
!videos/default/**

# But allow the ECKO folder
!videos/ECKO/
!videos/ECKO/**

# But allow the CivChan folder
!videos/CivChan/
!videos/CivChan/**

# Ignore this file
eckotest.py
ecko_session.json
Docker.md

# Python
__pycache__/
*.pyc

# Runtime data
logs/
memories/
rag/conversations/

# SSL
ssl/
*.pem
